{
  "name": "@folio/stripes-components",
  "version": "13.1.0",
  "description": "Component library for building Stripes applications.",
  "license": "Apache-2.0",
  "repository": "folio-org/stripes-components",
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "registry": "https://repository.folio.org/repository/npm-folio/"
  },
  "scripts": {
    "docs:readme:check": "node ./scripts/generate-readme-mdx.js --check",
    "docs:readme:clean": "node ./scripts/generate-readme-mdx.js --clean",
    "docs:readme:generate": "node ./scripts/generate-readme-mdx.js",
    "docgen": "react-docgen ./lib/ --pretty -e index.js -o ./docs/reactdoc.json ",
    "eslint": "eslint ./",
    "formatjs-compile": "stripes translate compile",
    "lint": "stripes-lint ./lib ./hooks ./util",
    "lint:fix": "stripes-lint --fix ./lib ./hooks ./util",
    "storybook": "node ./scripts/run-storybook-dev.js",
    "prestorybook-build": "yarn docs:readme:generate",
    "storybook-build": "storybook build -c .storybook -o .out",
    "stylelint": "stylelint \"lib/**/*.css\"",
    "test": "stripes test karma",
    "test-dev": "stripes test karma --watch"
  },
  "stripes": {
    "type": "components",
    "actionNames": [
      "selectPreviousRow",
      "selectNextRow",
      "selectFirstOrCurrentRow",
      "unfocusRow",
      "focusBeyond"
    ]
  },
  "resolutions": {
    "polished": "4.2.2"
  },
  "devDependencies": {
    "@bigtest/interactor": "0.7.2",
    "@csstools/postcss-global-data": "^3.0.0",
    "@csstools/postcss-relative-color-syntax": "^3.0.7",
    "@folio/eslint-config-stripes": "folio-org/eslint-config-stripes#ESCONF-58",
    "@folio/stripes-cli": "^4.0.0",
    "@folio/stripes-testing": "^5.0.0",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/react-webpack5": "^10.3.5",
    "@svgr/webpack": "^8.1.0",
    "autoprefixer": "^10.4.13",
    "chai": "^4.1.2",
    "core-js": "^3.6.1",
    "faker": "^4.1.0",
    "karma-viewport": "^1.0.4",
    "mocha": "^10.2.0",
    "moment": "^2.29.0",
    "postcss": "^8.4.2",
    "postcss-custom-media": "^9.0.1",
    "postcss-import": "^15.0.1",
    "postcss-loader": "^7.0.2",
    "react": "^18.2",
    "react-dom": "^18.2",
    "react-intl": "^7.1.5",
    "react-markdown": "^10.1.0",
    "react-redux": "^8.0.5",
    "react-router": "^5.2.0",
    "react-router-dom": "^5.2.0",
    "redux": "^4.0.0",
    "redux-form": "^8.3.0",
    "regenerator-runtime": "^0.14.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sinon": "^17.0.0",
    "storybook": "^10.3.5",
    "stylelint": "^16.2.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-junit-formatter": "^0.2.2"
  },
  "dependencies": {
    "@folio/stripes-react-hotkeys": "^3.2.1",
    "classnames": "^2.2.5",
    "currency-codes": "2.1.0",
    "dayjs": "^1.11.10",
    "dompurify": "^3.3.3",
    "downshift": "9.0.13",
    "flexboxgrid2": "^7.2.0",
    "focus-trap": "^7.5.4",
    "json2csv": "^4.2.1",
    "lodash": "^4.17.4",
    "memoize-one": "^6.0.0",
    "moment-range": "^4.0.2",
    "moment-timezone": "^0.5.14",
    "normalize.css": "^8.0.1",
    "popper.js": "^1.14.6",
    "prop-types": "^15.5.10",
    "prop-types-extra": "^1.1.0",
    "query-string": "^8.1.0",
    "react-highlight-words": "^0.20.0",
    "react-quill": "^2.0.0",
    "react-transition-group": "^4.4.5",
    "react-virtualized-auto-sizer": "^1.0.2",
    "sourcemapped-stacktrace": "^1.1.11",
    "tai-password-strength": "^1.1.1",
    "usehooks-ts": "^3.1.1"
  },
  "peerDependencies": {
    "moment": "^2.29.0",
    "react-intl": "^7.1.5",
    "react-redux": "^8.0.5",
    "react-router-dom": "^5.2.0"
  }
}